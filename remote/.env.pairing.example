# Somente no servidor. NAO versionar credenciais reais.
PAIRING_DIR=/var/lib/termux-studio/pairings
# gere com: openssl rand -hex 32
PAIRING_MASTER_KEY=GERAR_64_HEX_RANDOM
PAIRING_PORT=8790
# Apenas para comando de emissão no servidor (não são lidos pelo daemon HTTP):
PAIRING_MQTT_URL=mqtts://mqtt.example.com:8883
# PAIRING_MQTT_PASSWORD deve ser informado somente no momento de emitir o código.
